{
  "name": "typr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "menu": "node scripts/commands.mjs",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:build:debug": "tauri build --debug",
    "check": "tsc --noEmit",
    "rust:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "clean": "node scripts/commands.mjs clean",
    "clean:rust": "node scripts/commands.mjs clean:rust",
    "setup:sidecar": "node scripts/build-sidecar.mjs",
    "doctor": "node scripts/commands.mjs doctor"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
"@tauri-apps/plugin-shell": "^2.3.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
