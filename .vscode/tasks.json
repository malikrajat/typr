{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Typr: Developer menu",
      "type": "shell",
      "command": "npm run menu",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Typr: Dev (desktop)",
      "type": "shell",
      "command": "npm run app:dev",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Typr: Dev (web UI only)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Typr: Build desktop (release)",
      "type": "shell",
      "command": "npm run app:build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Typr: Build desktop (debug)",
      "type": "shell",
      "command": "npm run app:build:debug",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Typr: Build web frontend",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Typr: Check TypeScript",
      "type": "shell",
      "command": "npm run check",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Typr: Check Rust",
      "type": "shell",
      "command": "cargo check --manifest-path src-tauri/Cargo.toml",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Typr: Test Rust",
      "type": "shell",
      "command": "cargo test --manifest-path src-tauri/Cargo.toml",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Typr: Check everything",
      "dependsOrder": "sequence",
      "dependsOn": ["Typr: Check TypeScript", "Typr: Check Rust"],
      "problemMatcher": []
    },
    {
      "label": "Typr: Doctor",
      "type": "shell",
      "command": "npm run doctor",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Typr: Build whisper sidecar",
      "type": "shell",
      "command": "npm run setup:sidecar",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "Typr: Format Rust",
      "type": "shell",
      "command": "npm run rust:fmt",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Typr: Clean frontend output",
      "type": "shell",
      "command": "npm run clean",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
